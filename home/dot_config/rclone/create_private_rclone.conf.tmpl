{{- /*
  rclone's config: the Google Drive remote that rclone-drive.service mounts.

  create_: written only when ~/.config/rclone/rclone.conf doesn't exist yet.
  After that rclone owns the file (it rewrites the token on every refresh),
  so chezmoi never touches it again. The stat check also keeps chezmoi from
  asking Bitwarden for the secret on every apply.

  The client ID and secret come from the Bitwarden item "rclone-drive" (custom
  fields client_id and client_secret). On a new machine's first apply bw isn't
  installed or unlocked yet, so the file is skipped; it's written by a later
  apply, after export BW_SESSION="$(bw unlock --raw)". There's no token here:
  sign in once with `rclone config reconnect gdrive:`.
*/ -}}
{{- if and (not (stat (joinPath .chezmoi.homeDir ".config/rclone/rclone.conf"))) (env "BW_SESSION") (lookPath "bw") -}}
{{- $item := bitwardenFields "item" "rclone-drive" -}}
[gdrive]
type = drive
client_id = {{ $item.client_id.value }}
client_secret = {{ $item.client_secret.value }}
scope = drive
{{ end -}}
